{
  "name": "nostalgictrees-wiki",
  "version": "0.2.0",
  "private": true,
  "description": "VitePress sources for the Nostalgic mod wikis on nostalgic.am",
  "scripts": {
    "dev:trees": "vitepress dev wiki-src/nostalgictrees",
    "dev:dialog": "vitepress dev wiki-src/nostalgicdialog",
    "build:trees": "vitepress build wiki-src/nostalgictrees",
    "build:dialog": "vitepress build wiki-src/nostalgicdialog",
    "build": "npm run build:trees && npm run build:dialog",
    "preview:trees": "vitepress preview wiki-src/nostalgictrees",
    "preview:dialog": "vitepress preview wiki-src/nostalgicdialog"
  },
  "devDependencies": {
    "vitepress": "^1.5.0"
  }
}
